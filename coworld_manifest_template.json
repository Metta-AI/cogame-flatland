      "parOnTime": 15,
      "slackTicks": 24,
      "minJourneyCells": 12,
      "departStagger": 4,
      "malfunctionRate": 300,
      "malfunctionMinDuration": 8,
      "malfunctionMaxDuration": 24,
      "jamTicks": 12,
      "deadlockTicks": 24,
